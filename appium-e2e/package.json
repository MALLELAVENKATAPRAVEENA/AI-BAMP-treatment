{
  "name": "bamp-appium-e2e-framework",
  "version": "1.0.0",
  "description": "Enterprise Production-Ready Appium 2.x Mobile E2E Automation Framework for Android App (com.bamp.ai)",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json tests/**/*.test.js",
    "test:emulator": "cross-env DEVICE_TYPE=emulator npm run test",
    "test:device": "cross-env DEVICE_TYPE=real_device npm run test",
    "test:apk": "cross-env USE_APK=true npm run test",
    "test:installed": "cross-env USE_APK=false npm run test",
    "discover-routes": "node utilities/androidAppDiscoverer.js",
    "report:excel": "node -e \"require('./utilities/excelReporter').generateFinalReport()\""
  },
  "keywords": [
    "appium",
    "appium2",
    "android",
    "uiautomator2",
    "webdriverio",
    "mocha",
    "chai",
    "exceljs",
    "mochawesome",
    "winston",
    "page-object-model",
    "mobile-automation"
  ],
  "author": "Senior Mobile QA Automation Architect",
  "license": "MIT",
  "dependencies": {
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "mochawesome-report-generator": "^6.2.0",
    "webdriverio": "^8.32.0",
    "winston": "^3.12.0"
  }
}
