rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Administrator' || request.auth.token.admin == true);
    }
    
    function isOrthodontist() {
      return isAuthenticated() && (getUserRole() == 'Orthodontist' || isAdmin());
    }
    
    function isResearcher() {
      return isAuthenticated() && (getUserRole() == 'Researcher' || isAdmin());
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allowed during signup registration
      allow update, delete: if isAdmin() || request.auth.uid == userId;
    }

    // Patients Collection
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // Growth Assessments Collection
    match /growthAssessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // X-Rays Collection
    match /xrays/{xrayId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // Landmarks Collection
    match /landmarks/{landmarkId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // Cephalometric Measurements Collection
    match /cephalometricMeasurements/{measurementId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // AI Predictions Collection
    match /predictions/{predictionId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // PDF Reports Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isOrthodontist();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isResearcher();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Audit logs are immutable
    }
  }
}
