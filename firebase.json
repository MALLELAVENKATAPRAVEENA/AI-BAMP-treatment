{
  "hosting": {
    "site": "bamp-1de96",
    "public": "web/frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "web/firebase/firestore.rules",
    "indexes": "web/firebase/firestore.indexes.json"
  }
}
