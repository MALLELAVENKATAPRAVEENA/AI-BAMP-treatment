{
  "name": "ai-bamp-treatment",
  "version": "1.0.0",
  "scripts": {
    "build": "npm --prefix web/frontend run build && powershell -Command \"Copy-Item 'web\\frontend\\dist\\index.html' 'web\\frontend\\dist\\404.html' -Force; New-Item -ItemType Directory -Path 'dist' -Force; Copy-Item -Path 'web\\frontend\\dist\\*' -Destination 'dist' -Recurse -Force\"",
    "dev:frontend": "npm --prefix web/frontend run dev",
    "dev:backend": "npm --prefix web/backend run dev",
    "start:backend": "npm --prefix web/backend run start",
    "discover-routes": "npm --prefix selenium-e2e run discover-routes",
    "test": "npm --prefix selenium-e2e run test",
    "test:headless": "npm --prefix selenium-e2e run test:headless",
    "test:chrome": "npm --prefix selenium-e2e run test:chrome",
    "test:firefox": "npm --prefix selenium-e2e run test:firefox",
    "test:edge": "npm --prefix selenium-e2e run test:edge",
    "report:excel": "npm --prefix selenium-e2e run report:excel"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0"
  }
}
